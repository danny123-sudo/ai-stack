# Local secrets for the AI stack. Copy to .env, fill in, then run:
#   powershell -ExecutionPolicy Bypass -File apply-secrets.ps1
# New omniroute dashboard password (replaces the default)
OMNIROUTE_ADMIN_PASSWORD=
# From aistudio.google.com -> Get API key
GEMINI_API_KEY=
# Written by apply-secrets.ps1 - paste this into Cline as its API key
OMNIROUTE_CLINE_KEY=
# From console.groq.com -> API Keys
GROQ_API_KEY=
# From build.nvidia.com -> Get API Key
NVIDIA_API_KEY=
# Cloudflare Workers AI: account ID is the hex string in the dashboard URL
CLOUDFLARE_ACCOUNT_ID=
# My Profile -> API Tokens -> Create Token -> "Workers AI" template
CLOUDFLARE_API_TOKEN=
